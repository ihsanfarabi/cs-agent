<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CsAgent.Core\CsAgent.Core.csproj" />
    <ProjectReference Include="..\CsAgent.Http\CsAgent.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>

    <!-- dotnet tool packaging (Next Step 9) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cs-agent</ToolCommandName>
    <PackageId>cs-agent</PackageId>
    <Version>0.5.0</Version>
    <PackageDescription>Verifier-gated support resolution engine — answers support questions from your own docs with page citations, escalating anything it cannot verify. Microsoft Agent Framework showcase.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ihsanfarabi/cs-agent</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
